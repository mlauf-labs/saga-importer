<Window x:Class="SagaImporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saga Importer"
        Width="720" Height="560"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/tray.ico">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,8,8,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <TabControl>
            <!-- STATUS / LOG TAB -->
            <TabItem Header="Status">
                <Grid Margin="8" DataContext="{Binding Status}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Summary -->
                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Connection: " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConnectionState}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="State: " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PauseResumeText, StringFormat='{}{0} available'}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Watching: " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WatchedFolder}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Counters -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1F2937" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Queued" Foreground="#9CA3AF" FontSize="11" />
                                <TextBlock Text="{Binding QueueCount}" Foreground="White" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="#065F46" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Imported" Foreground="#A7F3D0" FontSize="11" />
                                <TextBlock Text="{Binding ImportedCount}" Foreground="White" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="#7F1D1D" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Failed" Foreground="#FECACA" FontSize="11" />
                                <TextBlock Text="{Binding FailedCount}" Foreground="White" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="#374151" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="Skipped" Foreground="#D1D5DB" FontSize="11" />
                                <TextBlock Text="{Binding SkippedCount}" Foreground="White" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Log -->
                    <Border Grid.Row="2" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                        <ListBox x:Name="LogList"
                                 ItemsSource="{Binding LogLines}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch" />
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Test connection" Command="{Binding TestConnectionCommand}" />
                        <Button Content="{Binding PauseResumeText}" Command="{Binding TogglePauseCommand}" />
                        <Button Content="Rescan now" Command="{Binding RescanNowCommand}" />
                        <Button Content="Open folder" Command="{Binding OpenWatchedFolderCommand}" />
                        <Button Content="Clear log" Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- SETTINGS TAB -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8" DataContext="{Binding Settings}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2">

                            <TextBlock Text="Watched folder" Style="{StaticResource Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding WatchedFolder}" Margin="0,0,8,4" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFolderCommand}" Margin="0,0,0,4" />
                            </Grid>

                            <TextBlock Text="Saga base URL" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding BaseUrl}" />

                            <TextBlock Text="API token" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="TokenBox" Padding="4,3" Margin="0,0,0,4" />

                            <CheckBox Content="Delete files only after Saga reports 'ready' (recommended)"
                                      IsChecked="{Binding DeleteAfterReady}" Margin="0,8,0,4" />

                            <UniformGrid Columns="3" Margin="0,4">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Ready timeout (min)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding StatusPollTimeoutMinutes}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Rescan interval (min)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding RescanIntervalMinutes}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Stability delay (s)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding StabilityDelaySeconds}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Failed subfolder name" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding FailedSubfolderName}" />

                            <TextBlock Text="Include extensions (comma-separated, empty = all)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding IncludeExtensions}" />

                            <TextBlock Text="Exclude extensions (comma-separated)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ExcludeExtensions}" />

                            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,4" />

                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,4">
                                <StackPanel>
                                    <TextBlock Text="Network share (SMB)" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#6B7280" Margin="0,0,0,6"
                                               Text="Share the watched folder so other machines can drop files into it. This needs admin rights, so Windows will ask for elevation." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SmbShareName}" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="Share folder" Command="{Binding ShareFolderCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Save" Command="{Binding SaveCommand}" />
                                <Button Content="Test connection" Command="{Binding TestConnectionCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2563EB" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
